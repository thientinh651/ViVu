<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"> <!-- Nền trong suốt để ăn theo nền xám nhạt của Màn hình mẹ -->

    <!-- Khu vực vòng tròn đếm ngược (Thẻ trắng) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_timer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/white"
        app:strokeWidth="0dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toTopOf="@+id/card_settings"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- VÒNG TRÒN ĐẾM NGƯỢC (Đã đổi sang Responsive tự co giãn) -->
            <View
                android:id="@+id/circle_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_circle_border"
                app:layout_constraintWidth_percent="0.65"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintBottom_toTopOf="@+id/button_layout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.45" />

            <TextView
                android:id="@+id/tv_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="02:00:00"
                android:textColor="#2D2A4A"
                android:textSize="44sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/circle_bg"
                app:layout_constraintEnd_toEndOf="@+id/circle_bg"
                app:layout_constraintStart_toStartOf="@+id/circle_bg"
                app:layout_constraintTop_toTopOf="@+id/circle_bg"
                app:layout_constraintVertical_bias="0.45" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready to start"
                android:textColor="#A0A0A0"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                app:layout_constraintEnd_toEndOf="@+id/tv_countdown"
                app:layout_constraintStart_toStartOf="@+id/tv_countdown"
                app:layout_constraintTop_toBottomOf="@+id/tv_countdown" />

            <!-- NÚT ĐIỀU KHIỂN -->
            <LinearLayout
                android:id="@+id/button_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <!-- Nút Start (Màu Tím) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_start_pause_container"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:cardCornerRadius="32dp"
                    app:cardBackgroundColor="#9D76F5"
                    app:strokeWidth="0dp"
                    app:cardElevation="2dp">

                    <ImageView
                        android:id="@+id/btn_start_pause_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_play"
                        app:tint="@color/white" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Nút Reset (Trắng viền Tím) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_reset_container"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="20dp"
                    app:cardCornerRadius="32dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeColor="#9D76F5"
                    app:strokeWidth="2dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/btn_reset"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_reset"
                        app:tint="#9D76F5" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Khu vực cài đặt thời gian (Thẻ trắng) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/card_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="0dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Timer Settings"
                    android:textColor="#2D2A4A"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Khung Dropdown Timer -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#F8F9FA"
                    app:strokeWidth="0dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <Spinner
                        android:id="@+id/spinner_duration"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:paddingHorizontal="12dp" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_set_time"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="#F8F9FA"
                    app:strokeWidth="0dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/tv_selected_time"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:text="Or set target time (e.g. 11:25)"
                        android:textColor="#666666"
                        android:textSize="15sp" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_set_sound"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="#F8F9FA"
                    app:strokeWidth="0dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/tv_selected_sound"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:text="Select alarm sound"
                        android:textColor="#666666"
                        android:textSize="15sp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>