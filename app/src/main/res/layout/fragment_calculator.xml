<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="4dp"
    android:paddingEnd="6dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:minHeight="120dp"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tv_calculator_expression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="#C7C7C7"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_calculator_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="end"
            android:text="0"
            android:textColor="#111111"
            android:textSize="42sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:background="#1A1A1A" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alignmentMode="alignMargins"
        android:columnCount="4"
        android:useDefaultMargins="false">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_calc_clear"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_calc_button_operator"
            app:backgroundTint="@null"
            android:elevation="1dp"
            android:fontFamily="sans-serif-medium"
            android:text="C"
            android:textAllCaps="false"
            android:textColor="#5E5E5E"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_calc_delete"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_calc_button_operator"
            app:backgroundTint="@null"
            android:elevation="1dp"
            android:fontFamily="sans-serif-medium"
            android:text="⌫"
            android:textAllCaps="false"
            android:textColor="#5E5E5E"
            android:textSize="19sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_calc_percent"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_calc_button_operator"
            app:backgroundTint="@null"
            android:elevation="1dp"
            android:fontFamily="sans-serif-medium"
            android:text="%"
            android:textAllCaps="false"
            android:textColor="#5E5E5E"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_calc_divide"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_calc_button_operator"
            app:backgroundTint="@null"
            android:elevation="1dp"
            android:fontFamily="sans-serif-medium"
            android:text="÷"
            android:textAllCaps="false"
            android:textColor="#5E5E5E"
            android:textSize="21sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_calc_1"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_calc_button_number"
            app:backgroundTint="@null"
            android:elevation="1dp"
            android:fontFamily="sans-serif-medium"
            android:text="1"
            android:textAllCaps="false"
            android:textColor="#2F2F2F"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_calc_2"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_calc_button_number"
            app:backgroundTint="@null"
            android:elevation="1dp"
            android:fontFamily="sans-serif-medium"
            android:text="2"
            android:textAllCaps="false"
            android:textColor="#2F2F2F"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_calc_3"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_calc_button_number"
            app:backgroundTint="@null"
            android:elevation="1dp"
            android:fontFamily="sans-serif-medium"
            android:text="3"
            android:textAllCaps="false"
            android:textColor="#2F2F2F"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_calc_multiply"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_calc_button_operator"
            app:backgroundTint="@null"
            android:elevation="1dp"
            android:fontFamily="sans-serif-medium"
            android:text="x"
            android:textAllCaps="false"
            android:textColor="#5E5E5E"
            android:textSize="21sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_calc_4"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_calc_button_number"
            app:backgroundTint="@null"
            android:elevation="1dp"
            android:fontFamily="sans-serif-medium"
            android:text="4"
            android:textAllCaps="false"
            android:textColor="#2F2F2F"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_calc_5"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_calc_button_number"
            app:backgroundTint="@null"
            android:elevation="1dp"
            android:fontFamily="sans-serif-medium"
            android:text="5"
            android:textAllCaps="false"
            android:textColor="#2F2F2F"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_calc_6"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_calc_button_number"
            app:backgroundTint="@null"
            android:elevation="1dp"
            android:fontFamily="sans-serif-medium"
            android:text="6"
            android:textAllCaps="false"
            android:textColor="#2F2F2F"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_calc_minus"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_calc_button_operator"
            app:backgroundTint="@null"
            android:elevation="1dp"
            android:fontFamily="sans-serif-medium"
            android:text="-"
            android:textAllCaps="false"
            android:textColor="#5E5E5E"
            android:textSize="21sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_calc_7"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_calc_button_number"
            app:backgroundTint="@null"
            android:elevation="1dp"
            android:fontFamily="sans-serif-medium"
            android:text="7"
            android:textAllCaps="false"
            android:textColor="#2F2F2F"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_calc_8"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_calc_button_number"
            app:backgroundTint="@null"
            android:elevation="1dp"
            android:fontFamily="sans-serif-medium"
            android:text="8"
            android:textAllCaps="false"
            android:textColor="#2F2F2F"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_calc_9"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_calc_button_number"
            app:backgroundTint="@null"
            android:elevation="1dp"
            android:fontFamily="sans-serif-medium"
            android:text="9"
            android:textAllCaps="false"
            android:textColor="#2F2F2F"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_calc_plus"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_calc_button_operator"
            app:backgroundTint="@null"
            android:elevation="1dp"
            android:fontFamily="sans-serif-medium"
            android:text="+"
            android:textAllCaps="false"
            android:textColor="#5E5E5E"
            android:textSize="21sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_calc_sign"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_calc_button_number"
            app:backgroundTint="@null"
            android:elevation="1dp"
            android:fontFamily="sans-serif-medium"
            android:text="+/-"
            android:textAllCaps="false"
            android:textColor="#FF8A3D"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_calc_0"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_calc_button_number"
            app:backgroundTint="@null"
            android:elevation="1dp"
            android:fontFamily="sans-serif-medium"
            android:text="0"
            android:textAllCaps="false"
            android:textColor="#2F2F2F"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_calc_decimal"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_calc_button_number"
            app:backgroundTint="@null"
            android:elevation="1dp"
            android:fontFamily="sans-serif-medium"
            android:text="."
            android:textAllCaps="false"
            android:textColor="#2F2F2F"
            android:textSize="22sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_calc_equals"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_calc_button_equals"
            app:backgroundTint="@null"
            android:elevation="1dp"
            android:fontFamily="sans-serif-medium"
            android:text="="
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />
    </GridLayout>
</LinearLayout>
