<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Hàng 1: Tên chuyến đi & Sửa & Xóa & Mũi tên -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_trip_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/item_trip_name_placeholder"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- NÚT SỬA BÚT CHÌ (MỚI THÊM) -->
            <ImageView
                android:id="@+id/btn_edit_trip"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_pencil_edit"
                app:tint="#4CAF50" />

            <!-- Nút Xóa Thùng Rác -->
            <ImageView
                android:id="@+id/btn_delete_trip"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_trash_simple"
                app:tint="#F44336" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="#B0BEC5" />
        </LinearLayout>

        <!-- Hàng 2: Trạng thái (Đang lên kế hoạch) -->
        <TextView
            android:id="@+id/tv_trip_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_badge_blue"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/item_trip_status_planning"
            android:textColor="#1976D2"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Hàng 3: Ngày tháng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_calendar"
                app:tint="#607D8B" />

            <TextView
                android:id="@+id/tv_trip_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="11/11/2025 - 21/06/2026"
                android:textColor="#546E7A"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Hàng 4: Ngân sách -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_currency_circle_dollar"
                app:tint="#607D8B" />

            <TextView
                android:id="@+id/tv_trip_budget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/item_trip_budget_placeholder"
                android:textColor="#546E7A"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>