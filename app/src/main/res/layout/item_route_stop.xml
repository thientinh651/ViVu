<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_outline_gray">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_order_index"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_circle_light_green"
                android:gravity="center"
                android:text="1"
                android:textColor="#2E7D32"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_stop_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/tv_order_index"
                android:text="@string/item_route_stop_name_placeholder"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_delete_stop"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_trash_simple"
                app:tint="#F44336" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#F8F9FA"
            android:orientation="vertical"
            android:padding="12dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/item_route_stop_expected_arrival" android:textColor="#757575"/>
                <TextView android:id="@+id/tv_exp_arrival" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:textColor="@color/black" android:textStyle="bold"/>
            </RelativeLayout>
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/item_route_stop_expected_departure" android:textColor="#757575"/>
                <TextView android:id="@+id/tv_exp_departure" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:textColor="@color/black" android:textStyle="bold"/>
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <CheckBox
                android:id="@+id/cb_arrived"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/item_route_stop_arrived"
                android:textSize="13sp" />
            <CheckBox
                android:id="@+id/cb_departed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/item_route_stop_departed"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/item_route_stop_actual_arrival" android:textSize="11sp"/>
                <TextView android:id="@+id/tv_actual_arrival" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="4dp" android:background="#F1F3F4" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:text="--:-- --/--" android:textColor="#757575" android:textSize="11sp"/>
            </LinearLayout>
            <View android:layout_width="12dp" android:layout_height="0dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/item_route_stop_actual_departure" android:textSize="11sp"/>
                <TextView android:id="@+id/tv_actual_departure" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="4dp" android:background="#F1F3F4" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:text="--:-- --/--" android:textColor="#757575" android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>