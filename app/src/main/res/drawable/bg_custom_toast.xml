<?xml version="1.0" encoding="utf-8"?>
<!-- drawable/bg_custom_toast.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Màu nền của Toast (Ví dụ màu trắng) -->
    <solid android:color="#FFFFFF" />

    <!-- Bo tròn các góc -->
    <corners android:radius="24dp" />

    <!-- Viền mỏng xung quanh để nổi bật -->
    <stroke
        android:width="1dp"
        android:color="#E0E0E0" />

    <!-- Khoảng cách từ viền chữ tới mép -->
    <padding
        android:left="16dp"
        android:right="16dp"
        android:top="10dp"
        android:bottom="10dp" />
</shape>